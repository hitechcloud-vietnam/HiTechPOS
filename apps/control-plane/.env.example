# HiTechPOS control plane
PORT=4100
PUBLIC_URL=https://app.hitechpos.vn
# STORE=memory   # dev only: data is lost on restart
CONTROL_URI=mongodb://localhost:27017
CONTROL_DB=hitechpos_control
# 64 hex chars; MUST equal TENANT_SECRET_KEY of every Posnic shard (upstream/pos/api/shard.js)
TENANT_SECRET_KEY=
SESSION_SECRET=
ADMIN_API_KEY=
SHOP_BASE_DOMAINS=hitechpos.vn
TENANT_DB_PREFIX=hitech_t_
# Posnic shard used to run the installer for new shops
SHARD_URL=http://127.0.0.1:6000
SHARD_SHOP_HEADER=x-hitech-shop
POSNIC_KEY=
POSNIC_SECRET=
# KCT = software service not subject to VAT; or a number (e.g. 10)
SAAS_VAT_RATE=KCT
GRACE_DAYS=7
# payOS (https://my.payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Pay2S (https://pay2s.vn)
PAY2S_ENV=sandbox
PAY2S_ACCESS_KEY=
PAY2S_PARTNER_CODE=
PAY2S_SECRET_KEY=
PAY2S_PARTNER_NAME=HiTechPOS
