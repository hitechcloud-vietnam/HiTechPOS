{
  "expo": {
    "name": "HiTechPOS Business",
    "slug": "hitechpos-business",
    "scheme": "vn.hitechpos.business",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.hitechpos.business",
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "package": "vn.hitechpos.business",
      "versionCode": 14,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "HiTechPOS Chủ cửa hàng"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Use Face ID to unlock your HiTechPOS Business account on this phone."
        }
      ]
    ],
    "icon": "./assets/posnic-icon.png"
  }
}
