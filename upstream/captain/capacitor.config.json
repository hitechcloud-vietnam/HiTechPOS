{
  "appId": "vn.hitechpos.captain",
  "appName": "HiTechPOS Captain",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  },
  "ios": {
    "limitsNavigationsToAppBoundDomains": false
  }
}
