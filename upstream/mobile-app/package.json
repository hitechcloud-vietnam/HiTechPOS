{
  "name": "posnic-mobile",
  "version": "0.3.0-beta.22",
  "private": true,
  "main": "index.ts",
  "description": "Offline-first mobile till for Posnic POS",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:attribution": "node scripts/check-attribution.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run check:attribution",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{json,ts}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "license": "AGPL-3.0-only"
}
