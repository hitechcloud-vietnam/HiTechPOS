# /etc/hitechpos/backup.env (mode 0600) - read by scripts/backup/*.sh as
# KEY=VALUE lines (never executed as shell). Anything unset here falls back to
# CONTROL_URI / CONTROL_DB / TENANT_MONGO_URI in /etc/hitechpos/control-plane.env.
# See docs/DEPLOYMENT.md "Sao lưu & khôi phục".

# MongoDB. A user with the built-in "backup" role is enough for backup.sh;
# restore-tenant.sh needs "restore". No database name in the URI path.
#BACKUP_MONGO_URI=mongodb://backup:***@127.0.0.1:27017/?replicaSet=rs0&authSource=admin
#BACKUP_TENANT_MONGO_URI=          # only when shop databases live on another cluster
#CONTROL_DB=hitechpos_control

BACKUP_DIR=/var/backups/hitechpos
#MONGO_TOOLS_DIR=/opt/mongodb-database-tools/bin   # when mongodump is not on PATH

# Retention (restic semantics): newest run of each of the last N days that
# have a run, and of each of the last M ISO weeks. Days are local time.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_TZ_OFFSET_MINUTES=420
BACKUP_KEEP_FAILED_DAYS=3

# Off-site copy (optional; either or both). Remote retention is the bucket's
# lifecycle rule, not this script.
#BACKUP_S3_URI=s3://hitechpos-backup/prod
#BACKUP_S3_ENDPOINT=https://s3.example-cloud.vn      # S3-compatible storage
#BACKUP_S3_EXTRA_ARGS=--storage-class STANDARD_IA
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=ap-southeast-1
#BACKUP_RCLONE_REMOTE=offsite:hitechpos-backup/prod
